{
  "identifier": "default",
  "description": "Default capabilities for the Kimi desktop wrapper",
  "local": true,
  "remote": {
    "urls": [
      "https://kimi.ai",
      "https://*.kimi.ai",
      "https://kimi.com",
      "https://*.kimi.com",
      "https://kimi.moonshot.cn",
      "https://*.moonshot.cn"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-open-external",
    "shell:allow-open",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
